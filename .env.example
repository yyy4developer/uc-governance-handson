# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#   cp .env.example .env
#
# NOTE: The hands-on itself needs nothing from this file — it runs entirely in
# the browser (import this repo as a Git folder, then run the notebooks).
# This is only for the optional Lakehouse Federation reference implementation
# under terraform/.

# --- Databricks workspace (terraform provider) ---
# Prefer OAuth over a PAT.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=            # optional; leave empty if using OAuth

# --- Terraform: AWS federation (reference implementation) ---
AWS_REGION=us-west-2
# Redshift admin password is a SECRET. Set it in terraform.tfvars (gitignored),
# NOT here in a committed file. This line is only a reminder of the variable name.
# TF_VAR_redshift_admin_password=
