# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#   cp .env.example .env

# --- Databricks workspace (for CLI / bundle / terraform) ---
# Prefer OAuth (databricks auth login --host <url>) over PAT.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=            # optional; leave empty if using OAuth

# --- Unity Catalog target (core / なし版) ---
UC_CATALOG=main
UC_SCHEMA_BASE=uc_handson

# --- SQL Warehouse (for %sql cells / Genie) ---
UC_WAREHOUSE_ID=

# --- Terraform: AWS federation (あり版) ---
AWS_REGION=us-west-2
# Redshift admin password is a SECRET. Set it in terraform.tfvars (gitignored),
# NOT here in a committed file. This line is only a reminder of the variable name.
# TF_VAR_redshift_admin_password=
